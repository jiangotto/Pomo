# Temporary Office files
~$*

# Firmware
Firmware/**/.claude/
Firmware/**/temp/
Firmware/**/__Previews/
# Keep the Gowin project Configuration file, but not build products in impl/.
Firmware/**/impl/*
!Firmware/**/impl/Pomo_process_config.json
Firmware/**/__pycache__/
Firmware/**/*.vo
Firmware/**/*_tmp.v
Firmware/**/*.log
Firmware/**/*.rpt.html
Firmware/**/*_resource.html
Firmware/**/*.gprj.user
Firmware/**/*.rao
Firmware/**/*.vg
Firmware/**/*.ipc
Firmware/**/*.mod
Firmware/**/project.ini
Firmware/**/*.prj
Firmware/**/*.xml

# Version the durable Gowin IP outputs under src, alongside the generated .v.
# Their temp/ synthesis caches remain ignored.
!Firmware/**/src/**/*.ipc
!Firmware/**/src/**/*.vo
!Firmware/**/src/**/*_tmp.v
# This abandoned FIFO pairing template has no matching IP in the project.
Firmware/V2/src/fifo_hs/pair_gen/fifo_hs_mipi_pair_tmp.v

# Hardware
Hardware/**/History/
Hardware/**/__Previews/
Hardware/**/Project\ Logs\ for*/
Hardware/**/Project\ Outputs\ for*/
Hardware/**/*.zip
Hardware/**/*.REP
Hardware/**/*.RUL
Hardware/**/*.htm
Hardware/**/*.html
Hardware/**/PnPout/
Hardware/**/Status Report.Txt

# Local development settings and one-off Gowin probe scripts
.claude/
codex_synth_check.tcl
gowin_commands_probe.tcl
gowin_generate_mipi_bram_fifo.tcl
.mipi-research/
Firmware/**/sim/
transcript
